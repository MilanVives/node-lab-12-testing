{
  "name": "node-lab-12-testing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-force-exit \"test/**/*.test.js\"",
    "test:coverage": "node --test --test-force-exit --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/server.js\" \"test/**/*.test.js\"",
    "submit": "node scripts/submit.cjs"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
